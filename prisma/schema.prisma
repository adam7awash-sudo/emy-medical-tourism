model GalleryImage {
  id        String   @id @default(cuid())
  title     String   @default("")
  image     String
  videoUrl  String   @default("")
  category  String   @default("general")
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
